{
  "version": 2,
  "builds": [
    {
      "src": "server/index.js",
      "use": "@vercel/node"
    }
  ],
  "functions": {
    "server/index.js": {
      "includeFiles": [
        "public/**",
        "admin/**"
      ]
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server/index.js"
    }
  ]
}
