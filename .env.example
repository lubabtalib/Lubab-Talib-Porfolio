PORT=3001
JWT_SECRET=change-this-to-a-long-random-secret
ADMIN_USER=admin
ADMIN_PASS=change-this-password

# Required on Vercel/hosting so contact messages persist and appear in dashboard.
# Use a Postgres connection string from Neon, Supabase, Vercel Postgres, etc.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
